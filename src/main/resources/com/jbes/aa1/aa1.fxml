<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jbes.aa1.controllers.GatoController">
   <center>
      <TableView fx:id="tableGato" onMouseClicked="#cargarGato" prefHeight="405.0" prefWidth="459.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colNombre" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Nombre" />
          <TableColumn fx:id="colChip" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Nº de Chip" />
            <TableColumn fx:id="colPeso" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Peso" />
            <TableColumn fx:id="colVacunacion" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Vacunación" />
            <TableColumn fx:id="colFechaNacimiento" prefWidth="91.0" style="-fx-alignment: CENTER;" text="Fecha de nacimiento" />
        </columns>
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <left>
      <VBox prefHeight="387.0" prefWidth="188.0" spacing="3.0" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="CENTER" contentDisplay="CENTER" text="Datos del Gato" underline="true">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <Label text="Nombre" />
            <TextField fx:id="txtNombre" />
            <Label text="Nº de Chip" />
            <TextField fx:id="txtChip" />
            <Label text="Peso" />
            <TextField fx:id="txtPeso" />
            <Label text="Vacunación" />
            <ChoiceBox fx:id="cbVacunacion" prefWidth="150.0" />
            <Label text="Fecha de nacimiento" />
            <DatePicker fx:id="dpFechaNacimiento" />
            <HBox alignment="CENTER" prefHeight="55.0" prefWidth="126.0" spacing="10.0">
               <children>
                  <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscarGato" prefHeight="25.0" prefWidth="67.0" text="Buscar" />
               </children>
               <VBox.margin>
                  <Insets bottom="10.0" top="10.0" />
               </VBox.margin>
            </HBox>
            <HBox alignment="CENTER" prefHeight="55.0" prefWidth="126.0" spacing="10.0">
               <children>
                  <Button fx:id="btnAnadir" mnemonicParsing="false" onAction="#anadirGato" prefHeight="25.0" prefWidth="67.0" text="Añadir" />
                  <Button fx:id="btnModificar" mnemonicParsing="false" onAction="#modificarGato" prefHeight="25.0" prefWidth="67.0" text="Modificar" />
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="55.0" prefWidth="126.0" spacing="10.0">
               <children>
                  <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarGato" prefHeight="25.0" prefWidth="67.0" text="Eliminar" />
                  <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarGato" prefHeight="25.0" prefWidth="67.0" text="Limpiar" />
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
      </VBox>
   </left>
   <bottom>
      <Label fx:id="lblBarraEstado" text="Estado: listo" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="5.0" top="5.0" />
         </padding>
      </Label>
   </bottom>
</BorderPane>
